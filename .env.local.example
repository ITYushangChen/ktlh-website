# 复制此文件为 .env.local，填写真实值后重启开发服务器

# 后台管理员登录密码（自定义，建议使用强密码）
REACT_APP_ADMIN_PASSWORD=your_strong_password_here

# GitHub 仓库信息（用于自动提交更改）
REACT_APP_GITHUB_OWNER=ITYushangChen
REACT_APP_GITHUB_REPO=ktlh-website
REACT_APP_GITHUB_BRANCH=main

# DeepSeek API Key（用于一键翻译功能）
# 获取地址：https://platform.deepseek.com/api_keys
REACT_APP_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 联系页地图（可选）
# 默认打开「Google 地图」嵌入；若要默认显示 Apple 地图面板，设为 apple
# REACT_APP_CONTACT_DEFAULT_MAP=google
# 覆盖嵌入 iframe 的 src（默认已内置胶州上合示范区湘江路附近点位）
# REACT_APP_GOOGLE_MAPS_EMBED_SRC=https://www.google.com/maps/embed?pb=...
# 「在 Google 地图中打开」链接（默认与嵌入图同坐标）
# REACT_APP_GOOGLE_MAPS_OPEN_URL=https://www.google.com/maps/search/?api=1&query=...
# 地址关键词（仅 Apple 地图「在 Apple 地图中打开」与文案一致用）
# REACT_APP_GOOGLE_MAPS_QUERY=青岛市胶州上合示范区湘江路21号

# 页脚 Instagram：点击打开主页；悬停显示二维码（请将二维码图放到 public/images/qr-instagram.png）
# REACT_APP_INSTAGRAM_URL=https://www.instagram.com/your_handle/

# 页脚 Facebook：同上，二维码 public/images/qr-facebook.png
# REACT_APP_FACEBOOK_URL=https://www.facebook.com/your_page/
